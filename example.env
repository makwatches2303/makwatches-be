# Server Configuration
PORT=8080
ENVIRONMENT=development

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=pehnaw

# Redis Configuration
REDIS_URI=localhost:6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION_HOURS=24

# Logging
LOG_LEVEL=debug

# Firebase Configuration
FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
FIREBASE_BUCKET_NAME=your-firebase-bucket.appspot.com

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
# Set these to the values from your Google Cloud Console credentials.
# IMPORTANT: In the Google Cloud Console you must add the frontend origins below to "Authorized JavaScript origins"
# and add the `GOOGLE_REDIRECT_URL` values to "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local development callback (backend running on localhost)
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Example production values you should also add to Google Cloud Console:
# Authorized JavaScript origins (add both):
# https://mak-watches.vercel.app
# https://makwatches.in
# Authorized redirect URIs (add both):
# https://mak-watches.vercel.app/auth/google/callback
# https://makwatches.in/auth/google/callback

# CORS Configuration
# Comma-separated list of allowed origins in production
# Include your primary domain and any subdomains that host the frontend
ALLOWED_ORIGINS=https://makwatches.in,https://www.makwatches.in,https://mak-watches.vercel.app
# Comma-separated list of allowed origins for local development
DEV_ORIGINS=http://localhost:4200,http://localhost:3000

# Razorpay Configuration
RAZORPAY_KEY=your_razorpay_key
RAZORPAY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# AWS S3 Configuration
AWS_S3_ACCESS_KEY=your_aws_access_key
AWS_S3_SECRET_KEY=your_aws_secret_key
AWS_S3_REGION=ap-south-1
AWS_S3_BUCKET_NAME=pehnaw

# Delhivery Configuration (Shipping Partner)
# Get your API token from Delhivery One dashboard
DELHIVERY_API_TOKEN=your_delhivery_api_token
# Use https://staging-express.delhivery.com for testing, https://track.delhivery.com for production
DELHIVERY_BASE_URL=https://track.delhivery.com
# Pickup location name registered with Delhivery
DELHIVERY_PICKUP_LOCATION=your_registered_pickup_location

# Seller/Pickup Details (your business address for pickup)
DELHIVERY_SELLER_NAME=Mak Watches
DELHIVERY_SELLER_PHONE=your_phone_number
DELHIVERY_SELLER_ADDRESS=Your Business Address
DELHIVERY_SELLER_CITY=Your City
DELHIVERY_SELLER_STATE=Your State
DELHIVERY_SELLER_PINCODE=000000

# Return Address Details (where returns should be sent)
DELHIVERY_RETURN_ADDRESS=Your Return Address
DELHIVERY_RETURN_CITY=Your City
DELHIVERY_RETURN_STATE=Your State
DELHIVERY_RETURN_PINCODE=000000
DELHIVERY_RETURN_PHONE=your_return_phone_number

# Shared secret this backend requires on the Delhivery status callback.
# Delhivery does not sign its webhooks, so this is the only authentication
# available. Present it as an X-Delhivery-Token header or a ?token= query
# parameter on the callback URL configured in the Delhivery dashboard.
# REQUIRED: with this unset the webhook refuses every request, because an
# unauthenticated shipping callback can move an order to "delivered".
DELHIVERY_WEBHOOK_SECRET=generate_a_long_random_string

# What a Delhivery shipment costs the customer. This integration has no
# carrier rate API, so the figure is operational configuration rather than a
# carrier quote. 0 means shipping is included in the item price.
DELHIVERY_FLAT_SHIPPING_CHARGE=0

# ---------------------------------------------------------------------------
# Shiprocket Configuration (primary shipping partner)
# ---------------------------------------------------------------------------
# API user credentials, created under Settings > API > Configure in the
# Shiprocket dashboard. This must be a dedicated API user, not the account
# owner's login. Never commit the real values.
SHIPROCKET_EMAIL=api@example.com
SHIPROCKET_PASSWORD=your_shiprocket_api_password

# API root. The default is correct for production; there is no separate
# sandbox host on the external API.
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external

# Pickup location, exactly as registered in Shiprocket. It must already exist:
# the application validates it against GET /settings/company/pickup and never
# creates one. Check the current list with:
#   GET /api/v1/shipping/pickup-locations   (admin)
SHIPROCKET_PICKUP_LOCATION=your_registered_pickup_location

# Optional channel id for orders created through a specific Shiprocket channel.
SHIPROCKET_CHANNEL_ID=

# Security token Shiprocket sends on its shipping webhook as x-api-key.
# Set the same value here and in the Shiprocket webhook configuration.
# REQUIRED: with this unset the webhook refuses every request.
SHIPROCKET_WEBHOOK_SECRET=generate_a_long_random_string

# ---------------------------------------------------------------------------
# Shipping subsystem
# ---------------------------------------------------------------------------
# Which carrier books new shipments: shiprocket | delhivery
# Both providers stay registered regardless, so orders already booked with the
# other carrier remain trackable, cancellable and labellable.
SHIPPING_PROVIDER=shiprocket

# Refuse a checkout that carries no delivery selection, rather than quietly
# shipping at zero charge.
#
# Leave false until the storefront carrying the courier picker is deployed: a
# cached older bundle would otherwise be unable to place orders. Turn it on
# once that is live, so a stale or tampered client cannot place unpriced
# orders.
REQUIRE_SHIPPING_SELECTION=false

# GSTIN forwarded to carriers when set. Left empty it is omitted rather than
# sent blank.
SELLER_GSTIN=

# Default parcel figures, used because the product model carries no weight or
# dimensions yet. These are declared defaults for a wristwatch parcel, not
# verified measurements, and every shipment records that they came from here.
PACKAGE_DEFAULT_WEIGHT_GRAMS=500
PACKAGE_DEFAULT_LENGTH_CM=15
PACKAGE_DEFAULT_BREADTH_CM=10
PACKAGE_DEFAULT_HEIGHT_CM=8